%define unmangled_name proton-vpn-daemon
%define version {version}
%define src_dbus_service dbus.service
%define dst_dbus_service me.proton.vpn.split_tunneling.service
%define src_systemd_service systemd.service
%define dst_systemd_service me.proton.vpn.split_tunneling.service
%define src_introspection_xml dbus.conf
%define dst_introspection_xml me.proton.vpn.split_tunneling.conf
%define release 1

Prefix: %{{_prefix}}
Name: %{{unmangled_name}}
Version: %{{version}}
Release: %{{release}}%{{?dist}}
Summary: %{{unmangled_name}} library

Group: ProtonVPN
License: GPLv3
Vendor: Proton AG <opensource@proton.me>
URL: https://github.com/ProtonVPN/%{{unmangled_name}}
Source0: %{{unmangled_name}}-%{{version}}.tar.gz
Source1: %{{src_introspection_xml}}
Source2: %{{src_dbus_service}}
Source3: %{{src_systemd_service}}
BuildArch: noarch
BuildRoot: %{{_tmppath}}/%{{unmangled_name}}-%{{version}}-%{{release}}-buildroot

BuildRequires: python3-devel
BuildRequires: python3-setuptools
BuildRequires: systemd-rpm-macros
BuildRequires: systemd
BuildRequires: python3-dbus-fast
BuildRequires: python3-packaging
BuildRequires: python3-systemd
BuildRequires: python3-pyroute2
BuildRequires: python3-bcc
BuildRequires: python3-psutil
BuildRequires: wireguard-tools
BuildRequires: python3-proton-vpn-api-core > 0.44.0

Requires: systemd
Requires: python3-dbus-fast
Requires: python3-packaging
Requires: python3-systemd
Requires: python3-pyroute2
Requires: python3-bcc
Requires: python3-psutil
Requires: wireguard-tools
Requires: python3-proton-vpn-api-core > 0.44.0

%description
Contains the daemon for Proton VPN.

# pre un-uninstall/upgrade
%preun
systemctl stop %{{dst_systemd_service}}
systemctl disable %{{dst_systemd_service}}
systemctl daemon-reload

# post install/upgrade
%posttrans
systemctl daemon-reload
systemctl enable %{{dst_systemd_service}}
systemctl start %{{dst_systemd_service}}

%prep
%setup -n %{{unmangled_name}}-%{{version}} -n %{{unmangled_name}}-%{{version}}

%build
%{{python3}} setup.py build

%install

install -D -m 644 %{{SOURCE1}} %{{buildroot}}%{{_sysconfdir}}/dbus-1/system.d/%{{dst_introspection_xml}}
install -D -m 644 %{{SOURCE2}} %{{buildroot}}%{{_sysconfdir}}/dbus-1/system-services/%{{dst_dbus_service}}
install -D -m 644 %{{SOURCE3}} %{{buildroot}}%{{_unitdir}}/%{{dst_systemd_service}}
%{{python3}} setup.py install --single-version-externally-managed -O1 --root=$RPM_BUILD_ROOT --record=INSTALLED_FILES

%files -f INSTALLED_FILES
%{{python3_sitelib}}/proton_vpn_daemon-%{{version}}*.egg-info/
%{{_sysconfdir}}/dbus-1/system.d/%{{dst_introspection_xml}}
%{{_sysconfdir}}/dbus-1/system-services/%{{dst_dbus_service}}
%{{_unitdir}}/%{{dst_systemd_service}}
%defattr(-,root,root)

%changelog
